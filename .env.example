# Copy to .env.local for local development. Vercel gets the same names via
# Project Settings → Environment Variables.

# Supabase — Project Settings → API. Both are safe in the browser: the anon
# key only ever grants what row-level security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Turns the cc chat and tt translator on in the interface. Leave false until
# the server side below is configured and you have decided about API cost.
VITE_AI_ENABLED=false

# Turns the vv voice mode on. Separate from the switch above because it is a
# different provider on a different meter — minutes, not calls.
VITE_VOICE_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER ONLY. No VITE_ prefix, so these are never bundled into the browser.
# Set them in Vercel, never in a committed file.
# ---------------------------------------------------------------------------

# console.anthropic.com → API keys. Powers the cc chat and tt translator.
# Billed per token, separate from any Claude.ai subscription.
ANTHROPIC_API_KEY=

# aistudio.google.com → Get API key. Powers the vv voice mode through the
# Gemini Live API. Billed per minute of audio; see docs/realtime-voice.md.
GOOGLE_API_KEY=

# Supabase → Project Settings → API → service_role. Bypasses row-level
# security; used only to count AI calls per user. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Daily ceiling per learner, so one user cannot drain the API budget.
AI_DAILY_CHAT_LIMIT=40
AI_DAILY_TRANSLATE_LIMIT=120

# Voice is capped twice over: how many calls a learner may start each day, and
# how long each one may run. Multiply them for the daily worst case per account
# (6 x 10 = 60 minutes, which is roughly 0.60 EUR at current Live API rates).
AI_DAILY_VOICE_SESSIONS=6
VOICE_SESSION_MINUTES=10
