# Copy to .env.local for local development. Vercel gets the same names via
# Project Settings → Environment Variables.

# Supabase — Project Settings → API. Both are safe in the browser: the anon
# key only ever grants what row-level security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Turns the assistant on — chat, translator and voice together. Leave false
# until the server side below is configured. (VITE_VOICE_ENABLED=true does the
# same thing, for deployments that set that one first.)
VITE_AI_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER ONLY. No VITE_ prefix, so these are never bundled into the browser.
# Set them in Vercel, never in a committed file.
# ---------------------------------------------------------------------------

# Chat, translator and voice all run on Gemini, on each learner's OWN Google AI
# key, saved from the account panel and stored encrypted. This secret is what
# encrypts it. Any long random string works — e.g. `openssl rand -base64 48`.
# Rotating it invalidates every saved key (learners just paste theirs again).
KEY_ENCRYPTION_SECRET=

# The text model behind chat and the translator. Voice picks its own Live
# model. Override here if Google renames things.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Supabase → Project Settings → API → service_role. Bypasses row-level
# security; used only to count AI calls per user. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Daily ceilings per learner. Everyone is on their own key, so these protect
# the learner's quota from a runaway tab, not your bill — hence generous.
AI_DAILY_CHAT_LIMIT=200
AI_DAILY_TRANSLATE_LIMIT=400

# Voice is capped per learner: how many calls a day, and how long each may run.
# Since every learner is on their own key this protects THEIR bill, not yours —
# a tab left open, a key that leaks. 12 x 15 = 3 hours a day at most.
AI_DAILY_VOICE_SESSIONS=12
VOICE_TOKEN_HOURS=12
